# Template only — never put a real credential in this file.
# Copy it to mcp/.env and fill in the real values there:
#
#     cp .env.example .env
#
# If mcp/.env is absent the server falls back to api/.env.

# Required. Same connection string the Express API uses.
# Include the database name before the "?" or MongoDB defaults to "test".
MONGO_URI=

# Optional. Set to "true" to allow the delete_adoption / delete_volunteer tools.
# Left unset, those tools refuse to run. Deletes are permanent.
MCP_ALLOW_DELETE=false

# Optional. Set to "true" to mask applicant email addresses and phone numbers
# in every tool response, so real contact details never enter an LLM context.
MCP_REDACT_PII=false
